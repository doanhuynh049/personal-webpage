{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "routes": [
    { "handle": "filesystem" },
    { "src": "/api/(.*)", "dest": "/api/[...all].js" },
    { "src": "/(.*)", "dest": "/api/[...all].js" }
  ],
  "functions": {
    "api/[...all].js": {
      "maxDuration": 30,
      "includeFiles": "public/**"
    }
  }
}
