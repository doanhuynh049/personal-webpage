PORT=8637

# Neon pooler URL (same format as stock-webpage)
DATABASE_URL="postgresql://user:pass@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require&uselibpqcompat=true"

# Match stock-webpage: http = Neon HTTPS, pg = TCP (required for local Docker)
DB_DRIVER=http

# When Node cannot reach Neon (ETIMEDOUT) but psql works — start.sh auto-falls back to Docker.
# Force local Postgres: USE_LOCAL_DB=1 ./start.sh
# Or pin runtime (keeps DATABASE_URL for migrations/sync):
# RUNTIME_DATABASE_URL=postgresql://personal:personal@localhost:5434/personal_web
# DB_DRIVER=pg

SESSION_SECRET=change-this-to-a-random-string
ADMIN_PASSWORD=admin123

# Free local AI (Ollama) — no OpenAI or paid APIs
# Install: https://ollama.com then run: ollama pull llama3.2
# OLLAMA_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=llama3.2

# Optional: link this site to another domain
# PUBLIC_SITE_URL=https://your-main-website.com
# ADMIN_URL=https://your-portfolio.vercel.app/admin
# SHOW_ADMIN_LINK=0
