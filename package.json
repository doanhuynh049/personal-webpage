{
  "name": "personal-webpage",
  "version": "1.0.0",
  "description": "Personal portfolio with database-backed admin panel",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "seed": "node scripts/seed-personal-data.js",
    "probe-db": "node scripts/probe-db.js",
    "probe-neon": "node scripts/probe-neon.js",
    "db:up": "docker compose up -d db",
    "db:down": "docker compose down",
    "sync:db": "bash scripts/sync-db-from-neon.sh"
  },
  "dependencies": {
    "@neondatabase/serverless": "^0.10.4",
    "connect-pg-simple": "^10.0.0",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-session": "^1.18.1",
    "heic-convert": "^2.1.0",
    "multer": "^1.4.5-lts.1",
    "pdfkit": "^0.18.0",
    "pg": "^8.21.0",
    "ws": "^8.21.0"
  }
}
